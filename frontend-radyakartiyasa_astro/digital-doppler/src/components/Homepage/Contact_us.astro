---
import "bootstrap/dist/css/bootstrap.min.css";
import "../../styles/Homepage/Contact_us.css";
import 'bootstrap-icons/font/bootstrap-icons.css';
---

<!-- Contact Section -->
<section class="contact-section py-5 w-75" style="margin-left: 10%;">
  <div class="container">
      <span class="contact-label"> CONTACT US</span>
      <div class="row">
          <!-- HEADING -->
          <div class="col-md-5 d-flex align-items-center mb-5 " style="margin-left: 0px;">
              <h3 class="heading lebih" style="color: #DEE0FF;">Lebih dekat dengan kami</h3>
          </div>

          <!-- CONTACT INFORMATION -->
          <div class="col-md-7 mb-2  " >
              <div class="info-card p-4 rounded mb-2 kecil " style="font-size: 12px; width: 90%;">
                  <p>Kami dengan senang hati akan menjawab pertanyaan
                    Anda dan membantu Anda menentukan layanan
                    mana yang paling sesuai dengan kebutuhan Anda.</p> </br>
                  <h5 style="font-size: 12px;">Hubungi kami di: (0274) 373721</h5>
                  <p></p>
                  <h5 class="mt-3" style="font-size: 12px;">Lokasi kami</h5>
                  <p style="font-size: 12px;">Jl. Rotowijayan Blok No. 1, Panembahan,
                      Kecamatan Kraton, Kota Yogyakarta, Daerah Istimewa Yogyakarta</p>

                  <div class="row mb-2">
                      <div class="col-6">
                          <h5 style="font-size: 12px;">Official Website</h5>
                          <p style="font-size: 12px;">Kratonjogja.id</p>
                      </div>
                      <div class="col-6">
                          <h5 style="font-size: 12px;">Opening Hour</h5>
                          <p style="font-size: 12px;">Tuesday - Saturday, 8.30 a.m-2.30 p.m</p>
                      </div>
                  </div>
              </div>
            </div>
      </div>
  </div>
</section>

<script
  src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"
>
  import "bootstrap/dist/js/bootstrap.bundle.min.js";
</script>
