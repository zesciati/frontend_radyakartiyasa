---
import "bootstrap/dist/css/bootstrap.min.css";
import "../../styles/Homepage/Destinationeventslider.css";
import 'bootstrap-icons/font/bootstrap-icons.css';

// Import JSON data
import homeDestinationIndex from "../../data/Homepage/home-destinationindex.json";

title: "Destination Index"
description: "Destinasi"
permalink: "/Destination_index/museum-packages/"
layout: "default"
---

            <!-- NOTE DESTINATION INDEX & PROMO KUNJUNGAN SECTION -->
        <div class="container-fluid py-5" style="background-color: #fef9ec;">
          <div class="container">
            <div class="row align-items-center mb-4">
              <div class="col-md-9">
                <div class="badge py-2 px-3 d-inline-block mb-3 gelar " style="color: #15803D; background-color: #F0FDF4;">Destinasi</div>
                <h2 class="title">Paket Kunjungan Museum</h2>
              </div>
              <div class="col-md-3 text-md-end text-center">
                <a href="/destinationpage" class="btn btn-outline-dark border-0 icon-hover">Lihat semua Destinasi <img src="../img/icon/arrow-right.svg" class="ms-2 icon" alt="Arrow"></a>
              </div>
            </div>

            <div class="row g-4">
              <!-- Card 1 -->
              {homeDestinationIndex.map((item) => (
              <div class="col-lg-4 col-md-6">
                <div class="card h-100  border-0 " style="background: none;">
                  <img src={item.src} class="card-img-top rounded-0" alt={item.alt}>
                  <div class="card-body">
                    <h5 class="card-title">{item.title}</h5>
                    <p class="card-text">{item.text}</p>
                    <a href="#" class="btn btn-outline-warning informasi-detail">Informasi detail <img src="../img/icon/chevron-right-gold.svg" class="ms-2" alt="Chevron"></a>
                    <a href="#" class="btn btn-booking-color ms-2">Booking <img src="../img/icon/arrow-right-gold.svg" class="ms-2" alt="Arrow"></a>
                  </div>
                </div>
              </div>
              ))} 
            </div>
          </div>
        </div>

<script
  src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"
>
  import "bootstrap/dist/js/bootstrap.bundle.min.js";
</script>
