---
import Baselayout from "../../layouts/Baselayout.astro"
import "../../styles/Homepage/Home_gallery.css"

// Import JSON data
import homeGallery from "../../data/Homepage/home-gallery.json";
---

<Baselayout>
        <div class="bungkus">
          <div class="container py-5 position-relative mt-4 ">
            <!-- Header Section -->
            <div class="gallery-header">
              <span class="badge">Gallery Museum</span>
              <h1 class="title mt-2">
                <img src="./img/logo-keraton.png" class="logo-keraton" alt="Logo Keraton">Teras Foto
              </h1>
            </div>

            <!-- Gallery Section -->
            <div class="row g-4 mt-5">
              {homeGallery.map((item) => (
              <!-- Image 1 -->
              <div class="col-12 col-sm-6 col-md-6 col-lg-3">
                <div class="card">
                  <img src={item.src} class="card-img-top" alt={item.alt}>
                  <div class="card-body">
                    <p class="card-text">{item.text}</p>
                  </div>
                </div>
              </div>

              <!-- Image 2 -->
              {/* <div class="col-12 col-sm-6 col-md-6 col-lg-3">
                <div class="card">
                  <img src="./img/pajangankuda.png" class="card-img-top" alt="Koleksi Museum">
                  <div class="card-body">
                    <p class="card-text">Koleksi di Kagungan Dalem Museum Waharanatha</p>
                  </div>
                </div>
              </div> */}

              <!-- Image 3 -->
              {/* <div class="col-12 col-sm-6 col-md-6 col-lg-3">
                <div class="card">
                  <img src="./img/keraton-ngayogyakarta.webp" class="card-img-top" alt="Museum Kedhaton">
                  <div class="card-body">
                    
                    <p class="card-text">Kagungan Dalem Museum Kedhaton</p>
                  </div>
                </div>
              </div> */}

              <!-- Image 4 -->
              {/* <div class="col-12 col-sm-6 col-md-6 col-lg-3">
                <div class="card">
                  <img src="./img/taman-sari2.png" class="card-img-top" alt="Taman Sari">
                  <div class="card-body">
                    <p class="card-text">Salah satu sudut Kagungan Dalem Taman Sari</p>
                  </div>
                </div>
              </div> */}
            ))}
            </div>

            

            <!-- Navigation Arrows -->
            <div class="d-flex mt-4 naviarrows">
              <button class="btn btn-outline-secondary butarrow"><i class="bi bi-chevron-left"></i></button>
              <button class="btn btn-outline-secondary butarrow"><i class="bi bi-chevron-right"></i></button>
            </div>
          </div>
        </div>

</Baselayout>