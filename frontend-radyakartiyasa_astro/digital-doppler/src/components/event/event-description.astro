---
import "bootstrap/dist/css/bootstrap.min.css";
import "../../styles/event/event-description.css/";
import 'bootstrap-icons/font/bootstrap-icons.css';
import EventInformation_sidebar from "./event-information_sidebar.astro";
// import Event from "../../pages/destination/event.astro";
---

<!-- EVENT DESCRIPTION SECTION -->
<section class="event-description container mt-5">
    <div class="row">
      <div class="col-md-7 event-text" style="color: #2D5D2B;">
        <h2>Deskripsi Acara dan Pameran</h2>
        <p>
          Acara dan pameran "Effective Product Marketing Techniques for
          Small Businesses" dirancang untuk membantu pelaku usaha kecil
          memahami dan menerapkan teknik pemasaran produk yang efektif. Dengan
          menghadirkan pembicara ahli, sesi workshop, dan showcase produk,
          acara ini memberikan wawasan mendalam tentang strategi pemasaran
          digital, branding, dan penggunaan media sosial untuk meningkatkan
          penjualan dan daya saing. Peserta juga akan mendapatkan kesempatan
          networking untuk berbagi pengalaman dan menjalin kolaborasi. Acara
          ini adalah langkah tepat bagi usaha kecil untuk berkembang di pasar
          yang kompetitif.
        </p>
        <p>
          Kami menantikan kedatangan Anda.
        </p>
        <p>
          <div class="btn btn-view-museum">
            <i class="bi bi-geo-alt-fill" style="color: gold;"></i>
            View museum map location <a href="#" class="bi bi-arrow-right" style="color: gold;"></a>
          </div>
        </p>
        <p>
            <div class="btn btn-booking">
            <i class="bi bi-ticket" style="color: gold;"></i>
            Booking sekarang <a href="#" class="bi bi-arrow-right" style="color: gold;"></a>
            </div>
        </p>
      </div>
    </div>
    <EventInformation_sidebar />
</section>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js">
    import "bootstrap/dist/js/bootstrap.bundle.min.js";
</script>