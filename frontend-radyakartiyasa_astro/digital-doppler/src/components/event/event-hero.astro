---
import "bootstrap/dist/css/bootstrap.min.css";
import "../../styles/event/event-hero.css/";
import 'bootstrap-icons/font/bootstrap-icons.css';
---

<!-- HERO CARDS SECTION -->
<section class="hero-cards-section">
    <div class="container">
      <h1>Effective product marketing <br> techniques for small businesses</h1>
      <div id="cardCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
          <div class="carousel-item active">
            <div class="row justify-content-center">
              <div class="col-md-4">
                <div class="card bg-transparent">
                  <img src="../img/Pengusaha-Kecil-Meskipun-Omzet-Tidak.webp" class="card-img-top" alt="Event Activity">
                  <p class="card-text text-center"><strong>Kegiatan Acara dan Pameran</strong></p>
                </div>
              </div>
              <div class="col-md-4">
                <div class="card bg-transparent">
                  <img src="../img/o_1ar2qjpgl12g41old1bg11dluurbt.jpeg" class="card-img-top" alt="Event Activity">
                  <p class="card-text text-center"><strong>Kegiatan Acara dan Pameran</strong></p>
                </div>
              </div>
              <div class="col-md-4">
                <div class="card bg-transparent">
                  <img src="../img/UMKM.jpg" class="card-img-top" alt="Event Activity">
                  <p class="card-text text-center"><strong>Kegiatan Acara dan Pameran</strong></p>
                </div>
              </div>
            </div>
          </div>
          <div class="carousel-item">
            <div class="row justify-content-center">
              <div class="col-md-4">
                <div class="card bg-transparent">
                  <img src="../img/UMKM.jpg" class="card-img-top" alt="Event Activity">
                  <p class="card-text text-center"><strong>Kegiatan Lain</strong></p>
                </div>
              </div>
              <div class="col-md-4">
                <div class="card bg-transparent">
                  <img src="../img/o_1ar2qjpgl12g41old1bg11dluurbt.jpeg" class="card-img-top" alt="Event Activity">
                  <p class="card-text text-center"><strong>Kegiatan Lain</strong></p>
                </div>
              </div>
              <div class="col-md-4">
                <div class="card bg-transparent">
                  <img src="../img/Pengusaha-Kecil-Meskipun-Omzet-Tidak.webp" class="card-img-top" alt="Event Activity">
                  <p class="card-text text-center"><strong>Kegiatan Lain</strong></p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- Carousel controls -->
        <button class="carousel-control-prev" style="left: 0px;" type="button" data-bs-target="#cardCarousel" data-bs-slide="prev">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" style="right: 0px;" type="button" data-bs-target="#cardCarousel" data-bs-slide="next">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Next</span>
        </button>
      </div>
  
  
    </div>
</section>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js">
    import "bootstrap/dist/js/bootstrap.bundle.min.js";
</script>