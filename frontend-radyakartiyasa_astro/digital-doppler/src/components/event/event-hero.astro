---
// Import JSON data
import eventHero from "../../data/event/event-hero.json";
import eventHero1 from "../../data/event/event-hero1.json";

import "bootstrap/dist/css/bootstrap.min.css";
import "../../styles/event/event-hero.css/";
import 'bootstrap-icons/font/bootstrap-icons.css';
import Navbar from "../Navbar.astro";
---

<!-- HERO CARDS SECTION -->
<section class="hero-cards-section">
  <Navbar/>
    <div class="container">
      <h1>Effective product marketing <br> techniques for small businesses</h1>
      <div id="cardCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
          <!-- !gambar nya masih sama belum berbeda-beda  -->
          {eventHero.map((item, index) => (
          <div class={`carousel-item ${index === 0 ? 'active' : ''}`}>
            <div class="row justify-content-center">
              <div class="col-md-4">
                <div class="card bg-transparent">
                  <img src={item.src} class="card-img-top" alt={item.alt}>
                  <p class="card-text text-center"><strong>{item.text}</strong></p>
                </div>
              </div>
              <div class="col-md-4">
                <div class="card bg-transparent">
                  <img src={item.src} class="card-img-top" alt={item.alt}>
                  <p class="card-text text-center"><strong>{item.text}</strong></p>
                </div>
              </div>
              <div class="col-md-4">
                <div class="card bg-transparent">
                  <img src={item.src} class="card-img-top" alt={item.alt}>
                  <p class="card-text text-center"><strong>{item.text}</strong></p>
                </div>
              </div>
            </div>
          </div>
          ))} 
          
