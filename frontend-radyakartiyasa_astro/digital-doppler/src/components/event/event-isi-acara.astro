---
import "bootstrap/dist/css/bootstrap.min.css";
import 'bootstrap-icons/font/bootstrap-icons.css';
import 'bootstrap-icons/font/bootstrap-icons.css';
---

<!-- ISI ACARA SECTION -->
<section class="acara-section">
    <div class="container-fluid" style="background-color: #0e3121;">
      <div class="row align-items-center">
        <div class="col-md-6 text-white align-items-center">
          <div class="text-image-container d-flex align-items-start" style="gap: 20px; margin-left: 20%;">
            <div>
              <img class="img-logo" src="../img/icon/Group 6.svg" alt="Logo" style="width: 20%; height: 10%;">
              <span class="fs-3" style="margin-left:4%; font-family: 'TenorSans-Regular';">Isi Acara</span>
              <br>
              <br>
              <ul class="list-unstyled" style="font-size: 20px;">
                <li><i class="bi bi-check"></i> Sesi Edukasi dan Workshop Interaktif</li>
                <li><i class="bi bi-check"></i> Pameran Produk dan Teknologi</li>
                <li><i class="bi bi-check"></i> Sesi Konsultasi dan Diskusi</li>
                <li><i class="bi bi-check"></i> Networking dan Kolaborasi</li>
                <li><i class="bi bi-check"></i> Hadiah dan Doorprize</li>
              </ul>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <img src="../img/meeting.jpg" alt="Foto Acara" class="img-fluid">
        </div>
      </div>
    </div>
</section>

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js">
    import "bootstrap/dist/js/bootstrap.bundle.min.js";
</script>