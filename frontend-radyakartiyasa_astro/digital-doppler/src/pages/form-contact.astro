---
import "../styles/form.css"
---
<div class="form-section">
    <div class="form-container">
        <form id="contactForm">
            <div class="form-group">
                <label class="form-label" for="name">Nama Anda</label>
                <input type="text" class="form-control" id="name" name="name" required>
            </div>
            <div class="form-group">
                <label class="form-label" for="email">Email</label>
                <input type="email" class="form-control" id="email" name="email" required>
            </div>
            <div class="form-group">
                <label class="form-label" for="phone_number">No. Handphone</label>
                <input type="text" class="form-control" id="phone_number" name="phone_number" required>
            </div>
            <div class="form-group">
                <label class="form-label" for="assistance_type">Apa yang bisa kami bantu?</label>
                <select class="form-select" id="assistance_type" name="assistance_type" required>
                    <option value="" disabled selected>Select Option</option>
                    <option value="1">Kendala</option>
                    <option value="2">Kritikan</option>
                    <option value="3">Masukan</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label" for="message">Pesan</label>
                <textarea class="form-control" id="message" name="message" rows="5" required></textarea>
            </div>

            <!-- Turnstile Captcha -->
            <div class="cf-turnstile" data-sitekey="0x4AAAAAAA60IP8ntKMCYlZ0M5oztMXMIps"></div>

            <div class="form-group">
                <button type="submit" class="btn">Submit</button>
            </div>
        </form>
        <div id="notification" style="display: none; margin-top: 20px;"></div>
    </div>
</div>

